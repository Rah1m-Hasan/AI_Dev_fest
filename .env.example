# =============================================================================
# Upay AI Financial Coach — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values.
# NEVER commit .env files to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local development (default - no setup required):
DATABASE_URL=sqlite:///./upay_demo.sqlite3

# Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/upay_coach

# -----------------------------------------------------------------------------
# AI / Groq Integration
# -----------------------------------------------------------------------------
# Optional. When empty, the app uses deterministic fallback responses.
# Get your key at: https://console.groq.com
GROQ_API_KEY=

# Model used for AI explanations (default for free tier):
GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# IMPORTANT: Change this to a secure random value in production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-before-production

# -----------------------------------------------------------------------------
# Frontend URL (used by CORS)
# -----------------------------------------------------------------------------
# Local development:
FRONTEND_URL=http://localhost:5173

# Production (Vercel deployment):
# FRONTEND_URL=https://your-app.vercel.app
