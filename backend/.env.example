# On Vercel, omitted DATABASE_URL uses /tmp/upay_demo.sqlite3 for this demo.
# For durable production data, configure PostgreSQL instead.
DATABASE_URL=sqlite:///./upay_demo.sqlite3
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_ENABLED=true
GROQ_TIMEOUT_SECONDS=10
JWT_SECRET_KEY=change-me-before-production
# Local development only. The frontend Vercel gateway does not require CORS.
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
